},
{
"t": "يَمَامَة",
"k": "7344b6ab"
},
{
"t": "نَافُورَةُ الحِكْمَة",
"k": "b0b2b3e7"
},
{
"t": "العِلْمُ نُور",
"k": "43b25610"
},
{
"t": "الصَّبْرُ مِفْتَاحُ الفَرَج",
"k": "fb7099ad"
},
{
"t": "الوَقْتُ مِنْ ذَهَب",
"k": "7fad59e4"
},
{
"t": "الصَّدِيقُ وَقْتَ الضِّيق",
"k": "294f97f3"
},
{
"t": "مَنْ جَدَّ وَجَد",
"k": "f8daf601"
},
{
"t": "يَدٌ وَاحِدَةٌ لَا تُصَفِّق",
"k": "74b3f1f3"
},
{
"t": "الجَارُ قَبْلَ الدَّار",
"k": "8c5b7ab1"
},
{
"t": "خَيْرُ الكَلَامِ مَا قَلَّ وَدَلّ",
"k": "14ba6509"
},
{
"t": "العَقْلُ السَّلِيمُ فِي الجِسْمِ السَّلِيم",
"k": "5fa7f8de"
},
{
"t": "القِرْدُ فِي عَيْنِ أُمِّهِ غَزَال",
"k": "f2d1800b"
},
{
"t": "عُصْفُورٌ فِي اليَدِ خَيْرٌ مِنْ عَشَرَةٍ عَلَى الشَّجَرَة",
"k": "b0ba21cc"
},
{
"t": "خَيْرُ جَلِيسٍ فِي الزَّمَانِ كِتَاب",
"k": "5473d16c"
},
{
"t": "التَّكْرَارُ يُعَلِّمُ الشُّطَّار",
"k": "a9351a8e"
},
{
"t": "مَنْ زَرَعَ حَصَد",
"k": "0e3bfa82"
},
{
"t": "مَا هُوَ الشَّيْءُ الَّذِي لَهُ أَسْنَانٌ وَلَا يَعَضّ؟",
"k": "a4d9f44f"
},
{
"t": "المُشْط",
"k": "4f05ee35"
},
{
"t": "مَا هُوَ الشَّيْءُ الَّذِي لَهُ عَيْنٌ وَلَا يَرَى؟",
"k": "59c6f9a8"
},
{
"t": "الإِبْرَة",
"k": "e0abc873"
},
{
"t": "مَا هُوَ البَيْتُ الَّذِي لَيْسَ لَهُ أَبْوَابٌ وَلَا نَوَافِذ؟",
"k": "cbb819a0"
},
{
"t": "البَيْضَة",
"k": "e4edefb4"
},
{
"t": "مَا هُوَ الشَّيْءُ الَّذِي لَهُ أَوْرَاقٌ وَلَيْسَ شَجَرَة؟",
"k": "804c0acd"
},
{
"t": "الكِتَاب",
"k": "a50ad790"
},
{
"t": "مَا هُوَ الشَّيْءُ الَّذِي يَتَكَلَّمُ كُلَّ لُغَاتِ العَالَم؟",
"k": "b3e7f5c2"
},
{
"t": "الصَّدَى",
"k": "f457515f"
},
{
"t": "أَخْضَرُ فِي الأَرْض، أَسْوَدُ فِي السُّوق، أَحْمَرُ فِي البَيْت. مَا هُوَ؟",
"k": "e41ba368"
},
